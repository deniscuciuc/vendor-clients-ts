{
  "name": "vendor-clients-ts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build --concurrency=4",
    "typecheck": "turbo run typecheck --concurrency=4",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "format": "biome format --write .",
    "verify": "pnpm check && pnpm typecheck && pnpm build && pnpm test && pnpm repo:check && pnpm test:scripts",
    "changeset": "changeset",
    "clean": "turbo run clean && shx rm -rf node_modules .turbo",
    "repo:check": "node scripts/repo-check.mjs check",
    "api:snapshot": "node scripts/repo-check.mjs snapshot api"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@changesets/cli": "^2.29.9",
    "@changesets/changelog-github": "^0.5.1",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/node": "^22.19.0",
    "@vitest/coverage-v8": "^5.0.0",
    "lefthook": "^2.1.12",
    "shx": "^0.4.0",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
