# Provenance, set here rather than as an environment variable.
#
# The publish workflow exports NPM_CONFIG_PROVENANCE=true, and on the first
# release that turned out not to reach the actual publish: `changeset publish`
# spawns pnpm, and the variable did not survive the hop. The packages went out
# with registry signatures but no attestation. Config in a committed .npmrc is
# read by pnpm directly, so it does.
#
# Safe to commit: it carries no credentials, and a scope-to-registry mapping is
# not needed now that the packages are on the public registry. It also makes a
# publish from a developer machine fail rather than silently produce an
# unattested tarball — local publishing is forbidden anyway (AGENTS.md).
provenance=true
